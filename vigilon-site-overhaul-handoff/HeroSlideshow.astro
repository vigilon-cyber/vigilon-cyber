---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import hero from '../assets/vigilon-hero.png';

interface Props {
  images?: ImageMetadata[];
}

const { images = [hero] } = Astro.props;
const slides = images.length ? images : [hero];
---

<vigilon-hero>
  <div class="media" aria-hidden="true">
    {slides.map((image, index) => (
      <div class:list={['slide', { active: index === 0 }]} data-slide>
        <Image
          src={image}
          alt=""
          width={image.width}
          widths={[640, 960, 1440, 1920].filter(width => width <= image.width)}
          sizes="100vw"
          format="webp"
          loading="eager"
          fetchpriority={index === 0 ? 'high' : 'low'}
        />
      </div>
    ))}
  </div>

  <div class="copy">
    <h1>Product cybersecurity compliance, from testing to ongoing reporting.</h1>
    <p>Navigate RED and CRA requirements with independent testing, technical documentation, and Vigilon Continuum.</p>
    <div class="actions">
      <slot name="actions" />
    </div>
  </div>

  {slides.length > 1 && (
    <div class="controls" hidden>
      <button type="button" data-previous aria-label="Previous background image">Previous</button>
      <button type="button" data-toggle>Pause slideshow</button>
      <button type="button" data-next aria-label="Next background image">Next</button>
    </div>
  )}
</vigilon-hero>

<script>
  class VigilonHero extends HTMLElement {
    connectedCallback() {
      const slides = Array.from(this.querySelectorAll<HTMLElement>('[data-slide]'));
      const controls = this.querySelector<HTMLElement>('.controls');
      const toggle = this.querySelector<HTMLButtonElement>('[data-toggle]');
      if (slides.length < 2 || !controls || !toggle) return;

      const events = new AbortController();
      const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let paused = motion.matches;
      let current = 0;
      let timer: ReturnType<typeof setInterval> | undefined;
      let inView = true;

      const stop = () => {
        if (timer !== undefined) clearInterval(timer);
        timer = undefined;
      };
      const show = (index: number) => {
        current = (index + slides.length) % slides.length;
        slides.forEach((slide, i) => slide.classList.toggle('active', i === current));
      };
      const sync = () => {
        stop();
        toggle.textContent = paused ? 'Play slideshow' : 'Pause slideshow';
        if (!paused && !document.hidden && inView) {
          timer = setInterval(() => show(current + 1), 7000);
        }
      };
      const manual = (direction: number) => {
        paused = true;
        show(current + direction);
        sync();
      };

      show(0);
      controls.hidden = false;
      toggle.addEventListener('click', () => {
        paused = !paused;
        sync();
      }, { signal: events.signal });
      this.querySelector('[data-previous]')?.addEventListener('click', () => manual(-1), { signal: events.signal });
      this.querySelector('[data-next]')?.addEventListener('click', () => manual(1), { signal: events.signal });
      document.addEventListener('visibilitychange', sync, { signal: events.signal });
      motion.addEventListener('change', () => {
        if (motion.matches) paused = true;
        sync();
      }, { signal: events.signal });

      const observer = new IntersectionObserver(([entry]) => {
        inView = entry.isIntersecting;
        sync();
      });
      observer.observe(this);
      sync();
      this.cleanup = () => {
        stop();
        events.abort();
        observer.disconnect();
      };
    }

    cleanup?: () => void;
    disconnectedCallback() { this.cleanup?.(); }
  }

  if (!customElements.get('vigilon-hero')) {
    customElements.define('vigilon-hero', VigilonHero);
  }
</script>

<style>
  vigilon-hero {
    position: relative;
    display: block;
    isolation: isolate;
    overflow: hidden;
    background: #071526;
    color: white;
  }
  .media { position: absolute; inset: 0; z-index: -1; }
  .slide { position: absolute; inset: 0; opacity: 0; transition: opacity 900ms ease; }
  .slide.active { opacity: 1; }
  .slide :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .copy { box-sizing: border-box; max-width: 1440px; margin: auto; padding: clamp(72px, 8vw, 140px) clamp(24px, 6vw, 96px); }
  h1 { max-width: 16ch; margin: 0 0 24px; font-size: clamp(36px, 4vw, 60px); line-height: 1.1; letter-spacing: -0.035em; text-wrap: balance; }
  p { max-width: 43ch; margin: 0 0 30px; font-size: clamp(17px, 1.4vw, 21px); line-height: 1.6; color: #d8e9f5; }
  .actions { display: flex; flex-wrap: wrap; gap: 16px; }
  .actions :global(a) { padding: 15px 22px; border-radius: 8px; background: #ff6b35; color: #0b1f3f; font-weight: 700; text-decoration: none; }
  .controls { position: absolute; right: 24px; bottom: 20px; display: flex; gap: 8px; }
  .controls[hidden] { display: none; }
  button { min-height: 44px; padding: 8px 14px; border: 1px solid #8eaac3; border-radius: 6px; background: #0b1f3f; color: white; cursor: pointer; font: inherit; }
  button:focus-visible, .actions :global(a:focus-visible) { outline: 3px solid #00d4ff; outline-offset: 4px; }
  @media (max-width: 760px) {
    vigilon-hero { display: flex; flex-direction: column; }
    .copy { order: 0; padding: 48px 24px 28px; width: 100%; }
    .media { order: 1; position: relative; inset: auto; width: 100%; aspect-ratio: 16 / 10; z-index: 0; }
    .slide :global(img) { object-position: 78% center; }
    .controls { order: 2; position: static; flex-wrap: wrap; justify-content: center; padding: 16px; }
    h1, p { max-width: none; }
  }
  @media (prefers-reduced-motion: reduce) { .slide { transition: none; } }
</style>
