---
/**
 * Homepage hero with stationary copy and actions over approved artwork.
 *
 * The static image always renders first: it is the LCP element, the fallback
 * for reduced motion and Save-Data, and what stays visible if the video can't
 * play. With `video`, a muted looping background video fades in over the
 * image after the page has loaded, with a visible pause/play control. It
 * pauses offscreen and in hidden tabs, and doesn't autoplay under
 * prefers-reduced-motion or Save-Data (visitors can still choose Play).
 *
 * Without `video`, passing more approved images enables a crossfade with
 * previous/next/pause controls. Adapted from the handoff starter component.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import hero from '../assets/vigilon-hero.png';

interface Props {
  headline: string;
  description: string;
  images?: ImageMetadata[];
  /** Public path to an H.264 MP4 with no audio track, framed like the first image. */
  video?: string;
}

const { headline, description, images = [hero], video } = Astro.props;
const available = images.length ? images : [hero];
const slides = video ? available.slice(0, 1) : available;
---

<vigilon-hero class="hero-slideshow">
  <div class="copy">
    <h1>{headline}</h1>
    <p class="description">{description}</p>
    <div class="actions">
      <slot name="actions" />
    </div>
    <slot name="note" />
  </div>

  <div class="media" aria-hidden="true">
    {slides.map((image, index) => (
      <div class:list={['slide', { active: index === 0 }]} data-slide>
        <Image
          src={image}
          alt=""
          widths={[640, 960, 1440, 1920].filter((width) => width <= image.width)}
          sizes="100vw"
          format="webp"
          loading={index === 0 ? 'eager' : 'lazy'}
          fetchpriority={index === 0 ? 'high' : 'low'}
        />
      </div>
    ))}
    {video && (
      <video class="hero-video" muted loop playsinline preload="none" tabindex="-1" data-hero-video>
        <source src={video} type="video/mp4" />
      </video>
    )}
  </div>

  {video && (
    <button type="button" class="video-toggle" data-video-toggle data-state="paused" hidden>
      <span class="video-toggle-icon" aria-hidden="true"></span>
      <span data-video-label>Play animation</span>
    </button>
  )}

  {slides.length > 1 && (
    <div class="controls" hidden>
      <button type="button" data-previous>Previous image</button>
      <button type="button" data-toggle>Pause slideshow</button>
      <button type="button" data-next>Next image</button>
    </div>
  )}
</vigilon-hero>

<script>
  const INTERVAL_MS = 7000;

  class VigilonHero extends HTMLElement {
    private cleanup?: () => void;

    connectedCallback() {
      const events = new AbortController();
      const teardown: Array<() => void> = [() => events.abort()];
      this.setupVideo(events.signal, teardown);
      this.setupSlideshow(events.signal, teardown);
      this.cleanup = () => teardown.forEach((dispose) => dispose());
    }

    disconnectedCallback() {
      this.cleanup?.();
    }

    private setupVideo(signal: AbortSignal, teardown: Array<() => void>) {
      const video = this.querySelector<HTMLVideoElement>('[data-hero-video]');
      const toggle = this.querySelector<HTMLButtonElement>('[data-video-toggle]');
      const label = toggle?.querySelector('[data-video-label]');
      if (!video || !toggle || !label || !video.canPlayType('video/mp4')) return;

      const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const { connection } = navigator as Navigator & { connection?: { saveData?: boolean } };
      // `wanted` is the visitor's choice; offscreen and hidden-tab pauses don't change it.
      let wanted = !motion.matches && !connection?.saveData;
      let inView = true;
      let loaded = document.readyState === 'complete';

      const render = () => {
        toggle.dataset.state = wanted ? 'playing' : 'paused';
        label.textContent = wanted ? 'Pause animation' : 'Play animation';
      };
      const sync = () => {
        const shouldPlay = wanted && inView && loaded && !document.hidden;
        if (shouldPlay && video.paused) {
          video.play().catch(() => {
            // Autoplay can be blocked (for example in low-power modes); leave the image and offer Play.
            wanted = false;
            render();
          });
        } else if (!shouldPlay && !video.paused) {
          video.pause();
        }
        render();
      };
      const fail = () => {
        wanted = false;
        video.pause();
        toggle.hidden = true;
        this.classList.remove('video-ready');
      };

      video.addEventListener('playing', () => this.classList.add('video-ready'), { signal });
      video.addEventListener('error', fail, { signal });
      video.querySelector('source')?.addEventListener('error', fail, { signal });
      toggle.addEventListener('click', () => { wanted = !wanted; sync(); }, { signal });
      document.addEventListener('visibilitychange', sync, { signal });
      motion.addEventListener('change', () => { if (motion.matches) wanted = false; sync(); }, { signal });
      if (!loaded) window.addEventListener('load', () => { loaded = true; sync(); }, { signal, once: true });

      const observer = new IntersectionObserver(([entry]) => { inView = entry.isIntersecting; sync(); });
      observer.observe(this);
      teardown.push(() => { observer.disconnect(); video.pause(); });

      toggle.hidden = false;
      sync();
    }

    private setupSlideshow(signal: AbortSignal, teardown: Array<() => void>) {
      const slides = Array.from(this.querySelectorAll<HTMLElement>('[data-slide]'));
      const controls = this.querySelector<HTMLElement>('.controls');
      const toggle = this.querySelector<HTMLButtonElement>('[data-toggle]');
      if (slides.length < 2 || !controls || !toggle) return;

      const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let paused = motion.matches;
      let current = 0;
      let inView = true;
      let timer: ReturnType<typeof setInterval> | undefined;

      const stop = () => {
        if (timer !== undefined) clearInterval(timer);
        timer = undefined;
      };
      const show = (index: number) => {
        current = (index + slides.length) % slides.length;
        slides.forEach((slide, i) => slide.classList.toggle('active', i === current));
      };
      const sync = () => {
        stop();
        toggle.textContent = paused ? 'Play slideshow' : 'Pause slideshow';
        if (!paused && !document.hidden && inView) timer = setInterval(() => show(current + 1), INTERVAL_MS);
      };
      const step = (direction: number) => {
        paused = true;
        show(current + direction);
        sync();
      };

      controls.hidden = false;
      toggle.addEventListener('click', () => { paused = !paused; sync(); }, { signal });
      this.querySelector('[data-previous]')?.addEventListener('click', () => step(-1), { signal });
      this.querySelector('[data-next]')?.addEventListener('click', () => step(1), { signal });
      document.addEventListener('visibilitychange', sync, { signal });
      motion.addEventListener('change', () => { if (motion.matches) paused = true; sync(); }, { signal });

      const observer = new IntersectionObserver(([entry]) => { inView = entry.isIntersecting; sync(); });
      observer.observe(this);
      teardown.push(() => { stop(); observer.disconnect(); });
      sync();
    }
  }

  if (!customElements.get('vigilon-hero')) customElements.define('vigilon-hero', VigilonHero);
</script>

<style>
  vigilon-hero {
    position: relative;
    display: block;
    isolation: isolate;
    overflow: hidden;
    background: #07131f;
    color: var(--color-white);
  }

  .media { position: absolute; inset: 0; z-index: -1; }
  .media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(7, 12, 22, 0.92) 0%, rgba(7, 12, 22, 0.75) 38%, rgba(7, 12, 22, 0) 62%);
  }
  .slide { position: absolute; inset: 0; opacity: 0; transition: opacity 900ms ease; }
  .slide.active { opacity: 1; }
  .slide :global(img), .hero-video { width: 100%; height: 100%; object-fit: cover; object-position: 85% 50%; }
  .hero-video { position: absolute; inset: 0; opacity: 0; transition: opacity 600ms ease; }
  vigilon-hero.video-ready .hero-video { opacity: 1; }

  .copy {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: clamp(3.5rem, 8vw, 7rem) 1.5rem clamp(3.5rem, 7vw, 6rem);
  }
  h1 {
    max-width: 17ch;
    margin: 0 0 1.25rem;
    font-size: clamp(2.25rem, 4.2vw, 3.5rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .description {
    max-width: 46ch;
    margin: 0 0 2rem;
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    line-height: 1.6;
    color: #d8e9f5;
  }
  .actions { display: flex; flex-wrap: wrap; gap: 0.875rem; }

  .video-toggle {
    position: absolute;
    right: 1.5rem;
    bottom: 1.25rem;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.5rem 0.95rem;
    border: 1px solid rgba(255, 255, 255, 0.55);
    border-radius: 999px;
    background: rgba(7, 12, 22, 0.72);
    color: var(--color-white);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s, border-color 0.2s;
  }
  .video-toggle:hover { background: rgba(7, 12, 22, 0.92); border-color: var(--color-white); }
  .video-toggle[hidden] { display: none; }
  .video-toggle:focus-visible { outline: 3px solid var(--color-electric-cyan); outline-offset: 3px; }
  .video-toggle-icon { display: inline-block; box-sizing: border-box; }
  .video-toggle[data-state='playing'] .video-toggle-icon {
    width: 10px;
    height: 12px;
    border-left: 3px solid currentColor;
    border-right: 3px solid currentColor;
  }
  .video-toggle[data-state='paused'] .video-toggle-icon {
    width: 0;
    height: 0;
    border-top: 6px solid transparent;
    border-bottom: 6px solid transparent;
    border-left: 10px solid currentColor;
  }

  .controls { position: absolute; right: 1.5rem; bottom: 1.25rem; display: flex; gap: 0.5rem; }
  .controls[hidden] { display: none; }
  .controls button {
    min-height: 44px;
    padding: 0.5rem 0.875rem;
    border: 1px solid #8eaac3;
    border-radius: 6px;
    background: var(--color-midnight-blue);
    color: var(--color-white);
    font: inherit;
    cursor: pointer;
  }
  .controls button:focus-visible { outline: 3px solid var(--color-electric-cyan); outline-offset: 3px; }

  @media (max-width: 880px) {
    vigilon-hero { display: flex; flex-direction: column; background: var(--color-midnight-blue); }
    .copy { width: 100%; padding: 2.5rem 1.5rem 2rem; }
    h1, .description { max-width: none; }
    .media { position: relative; inset: auto; z-index: 0; width: 100%; aspect-ratio: 16 / 10; }
    .media::after { background: linear-gradient(180deg, var(--color-midnight-blue) 0%, rgba(11, 31, 63, 0) 28%); }
    .slide :global(img), .hero-video { object-position: 80% 50%; }
    .video-toggle { right: 1rem; bottom: 1rem; }
    .controls { position: static; flex-wrap: wrap; justify-content: center; padding: 1rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .slide, .hero-video { transition: none; }
  }
</style>
