---
/**
 * Homepage hero with stationary copy and actions over approved artwork.
 *
 * One image renders a static hero with no controls or motion. Pass more
 * approved images to enable a crossfade with previous/next/pause controls
 * (paused under prefers-reduced-motion, offscreen, or in a hidden tab).
 * Adapted from the handoff starter component.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import hero from '../assets/vigilon-hero.png';

interface Props {
  headline: string;
  description: string;
  images?: ImageMetadata[];
}

const { headline, description, images = [hero] } = Astro.props;
const slides = images.length ? images : [hero];
---

<vigilon-hero class="hero-slideshow">
  <div class="copy">
    <h1>{headline}</h1>
    <p class="description">{description}</p>
    <div class="actions">
      <slot name="actions" />
    </div>
    <slot name="note" />
  </div>

  <div class="media" aria-hidden="true">
    {slides.map((image, index) => (
      <div class:list={['slide', { active: index === 0 }]} data-slide>
        <Image
          src={image}
          alt=""
          widths={[640, 960, 1440, 1920].filter((width) => width <= image.width)}
          sizes="100vw"
          format="webp"
          loading={index === 0 ? 'eager' : 'lazy'}
          fetchpriority={index === 0 ? 'high' : 'low'}
        />
      </div>
    ))}
  </div>

  {slides.length > 1 && (
    <div class="controls" hidden>
      <button type="button" data-previous>Previous image</button>
      <button type="button" data-toggle>Pause slideshow</button>
      <button type="button" data-next>Next image</button>
    </div>
  )}
</vigilon-hero>

<script>
  const INTERVAL_MS = 7000;

  class VigilonHero extends HTMLElement {
    private cleanup?: () => void;

    connectedCallback() {
      const slides = Array.from(this.querySelectorAll<HTMLElement>('[data-slide]'));
      const controls = this.querySelector<HTMLElement>('.controls');
      const toggle = this.querySelector<HTMLButtonElement>('[data-toggle]');
      if (slides.length < 2 || !controls || !toggle) return;

      const events = new AbortController();
      const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let paused = motion.matches;
      let current = 0;
      let inView = true;
      let timer: ReturnType<typeof setInterval> | undefined;

      const stop = () => {
        if (timer !== undefined) clearInterval(timer);
        timer = undefined;
      };
      const show = (index: number) => {
        current = (index + slides.length) % slides.length;
        slides.forEach((slide, i) => slide.classList.toggle('active', i === current));
      };
      const sync = () => {
        stop();
        toggle.textContent = paused ? 'Play slideshow' : 'Pause slideshow';
        if (!paused && !document.hidden && inView) timer = setInterval(() => show(current + 1), INTERVAL_MS);
      };
      const step = (direction: number) => {
        paused = true;
        show(current + direction);
        sync();
      };

      controls.hidden = false;
      toggle.addEventListener('click', () => { paused = !paused; sync(); }, { signal: events.signal });
      this.querySelector('[data-previous]')?.addEventListener('click', () => step(-1), { signal: events.signal });
      this.querySelector('[data-next]')?.addEventListener('click', () => step(1), { signal: events.signal });
      document.addEventListener('visibilitychange', sync, { signal: events.signal });
      motion.addEventListener('change', () => { if (motion.matches) paused = true; sync(); }, { signal: events.signal });

      const observer = new IntersectionObserver(([entry]) => { inView = entry.isIntersecting; sync(); });
      observer.observe(this);
      sync();

      this.cleanup = () => {
        stop();
        events.abort();
        observer.disconnect();
      };
    }

    disconnectedCallback() {
      this.cleanup?.();
    }
  }

  if (!customElements.get('vigilon-hero')) customElements.define('vigilon-hero', VigilonHero);
</script>

<style>
  vigilon-hero {
    position: relative;
    display: block;
    isolation: isolate;
    overflow: hidden;
    background: #07131f;
    color: var(--color-white);
  }

  .media { position: absolute; inset: 0; z-index: -1; }
  .media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(7, 12, 22, 0.92) 0%, rgba(7, 12, 22, 0.75) 38%, rgba(7, 12, 22, 0) 62%);
  }
  .slide { position: absolute; inset: 0; opacity: 0; transition: opacity 900ms ease; }
  .slide.active { opacity: 1; }
  .slide :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 85% 50%; }

  .copy {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: clamp(3.5rem, 8vw, 7rem) 1.5rem clamp(3.5rem, 7vw, 6rem);
  }
  h1 {
    max-width: 17ch;
    margin: 0 0 1.25rem;
    font-size: clamp(2.25rem, 4.2vw, 3.5rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .description {
    max-width: 46ch;
    margin: 0 0 2rem;
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    line-height: 1.6;
    color: #d8e9f5;
  }
  .actions { display: flex; flex-wrap: wrap; gap: 0.875rem; }

  .controls { position: absolute; right: 1.5rem; bottom: 1.25rem; display: flex; gap: 0.5rem; }
  .controls[hidden] { display: none; }
  .controls button {
    min-height: 44px;
    padding: 0.5rem 0.875rem;
    border: 1px solid #8eaac3;
    border-radius: 6px;
    background: var(--color-midnight-blue);
    color: var(--color-white);
    font: inherit;
    cursor: pointer;
  }
  .controls button:focus-visible { outline: 3px solid var(--color-electric-cyan); outline-offset: 3px; }

  @media (max-width: 880px) {
    vigilon-hero { display: flex; flex-direction: column; background: var(--color-midnight-blue); }
    .copy { width: 100%; padding: 2.5rem 1.5rem 2rem; }
    h1, .description { max-width: none; }
    .media { position: relative; inset: auto; z-index: 0; width: 100%; aspect-ratio: 16 / 10; }
    .media::after { background: linear-gradient(180deg, var(--color-midnight-blue) 0%, rgba(11, 31, 63, 0) 28%); }
    .slide :global(img) { object-position: 80% 50%; }
    .controls { position: static; flex-wrap: wrap; justify-content: center; padding: 1rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .slide { transition: none; }
  }
</style>
