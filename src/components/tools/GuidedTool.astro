---
/**
 * Server-rendered shell for a guided tool. Steps and results are rendered in
 * the browser by src/scripts/guided-tool.ts.
 */
import { TOOL_CARDS } from '../../lib/tools/registry.ts';
import type { ToolMode } from '../../lib/tools/registry.ts';
import type { ToolDefinition } from '../../lib/tools/types.ts';

interface Props {
  tool: ToolDefinition;
  mode: ToolMode;
}

const { tool, mode } = Astro.props;
const fallback = TOOL_CARDS.find((card) => card.toolId === tool.id)?.fallback;
---

<div class="guided-tool" data-guided-tool={tool.id} data-mode={mode}>
  {mode === 'unavailable' ? (
    <section class="container tool-unavailable">
      <p class="tool-kicker">{tool.name}</p>
      <h1>This check isn’t available yet</h1>
      <p>We’re reviewing its rules before we publish it. You can still get help with your product.</p>
      <div class="question-actions">
        <a href="/request-quote" class="btn btn-primary">Talk to an expert</a>
        {fallback && <a href={fallback.href} class="back-link">{fallback.label}</a>}
      </div>
    </section>
  ) : (
    <Fragment>
      <div class="container tool-top">
        <p class="tool-kicker">{tool.name}</p>
        {mode === 'preview' && (
          <p class="fixture-banner">
            <strong>Preview — not reviewed regulatory guidance.</strong> These rules are local fixtures based on the cited sources.
            They haven’t been reviewed by a qualified reviewer, so don’t rely on the result for compliance decisions.
          </p>
        )}
        <ol class="tool-stages" aria-label="Progress">
          {tool.stages.map((stage) => (
            <li data-stage={stage.id}>
              <span class="stage-label">{stage.label}</span><span class="sr-only stage-status"></span>
            </li>
          ))}
        </ol>
      </div>

      <div class="container tool-view" data-tool-view>
        <noscript>
          <h1>{tool.name}</h1>
          <p>This check needs JavaScript. You can <a href="/request-quote">request a quote</a> or email <a href="mailto:info@vigiloncyber.com">info@vigiloncyber.com</a> instead.</p>
        </noscript>
        <p class="tool-loading">Loading the check…</p>
      </div>

      {/* Hidden until the first step renders, so the step replacing the loading text doesn't shift it (CLS). */}
      <aside id="tool-help" class="container tool-help" aria-labelledby="tool-help-title" hidden>
        <h2 id="tool-help-title">Need help?</h2>
        <p>
          Email <a href="mailto:compliance@vigiloncyber.com">compliance@vigiloncyber.com</a> or
          <a href="/request-quote">talk to an expert</a>. {tool.summary}
        </p>
        <h2>Your answers</h2>
        <p>
          Your answers are stored only in this browser tab. They’re cleared when you close the tab or after two hours without
          activity, and nothing is sent to Vigilon unless you choose to send your result.
        </p>
        <button type="button" class="btn-link" data-reset>Clear my answers and start over</button>
      </aside>
    </Fragment>
  )}
</div>

<script>
  // Load the controller only when a checker is shown, not on the "isn’t available yet" page.
  if (document.querySelector('[data-guided-tool]:not([data-mode="unavailable"])')) {
    import('../../scripts/guided-tool.ts').then(({ mountGuidedTools }) => mountGuidedTools());
  }
</script>

<style is:global>
  .guided-tool { padding-block: 2rem 3rem; min-height: 70vh; }
  .guided-tool .container { max-width: 780px; }

  .tool-kicker { font-size: 0.875rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--color-intelligent-blue); }
  .fixture-banner {
    margin: 0.75rem 0 1rem; padding: 0.75rem 1rem; border: 2px dashed #8a6100; border-radius: var(--radius);
    background: #fff8e1; color: #3d2b00; font-size: 0.9rem; line-height: 1.5;
  }
  .tool-stages { display: flex; flex-wrap: wrap; gap: 0.25rem 0.5rem; margin-top: 0.75rem; list-style: none; font-size: 0.875rem; color: var(--color-text-light); }
  .tool-stages li { display: flex; align-items: center; gap: 0.5rem; }
  .tool-stages li + li::before { content: '→'; color: var(--color-border-strong); }
  .tool-stages li.current { color: var(--color-midnight-blue); font-weight: 700; }
  .tool-stages li.done .stage-label::before { content: '✓ '; }
  .tool-view { margin-top: 1.5rem; }
  .tool-loading { color: var(--color-text-light); }

  .tool-notice { margin-bottom: 1.25rem; padding: 0.75rem 1rem; border-left: 4px solid var(--color-intelligent-blue); border-radius: 0 var(--radius) var(--radius) 0; background: var(--color-surface); }

  .question fieldset { border: 0; min-width: 0; }
  .question legend { padding: 0; margin-bottom: 0.5rem; }
  .question-title, .result h1, .contact-step h1, .confirmation h1, .tool-unavailable h1 {
    font-size: clamp(1.6rem, 3.5vw, 2.25rem); line-height: 1.2; color: var(--color-midnight-blue); margin-bottom: 0.5rem;
  }
  .question-title:focus, .result h1:focus, .contact-step h1:focus, .confirmation h1:focus { outline: none; }
  .guided-tool .hint { color: var(--color-text-light); margin-bottom: 0.75rem; }

  .options { display: grid; gap: 0.75rem; margin: 1rem 0 1.5rem; }
  .option {
    position: relative; display: grid; grid-template-columns: 1.25rem minmax(0, 1fr); column-gap: 0.875rem; align-items: start;
    padding: 0.875rem 1rem; border: 2px solid var(--color-border-strong); border-radius: var(--radius); background: var(--color-white);
    transition: border-color 0.2s, background-color 0.2s, box-shadow 0.2s;
  }
  .option:hover { border-color: var(--color-intelligent-blue); }
  .option:has(input:checked) { border-color: var(--color-intelligent-blue); background: #eef5fa; box-shadow: inset 0 0 0 1px var(--color-intelligent-blue); }
  .option:has(input:focus-visible) { outline: 3px solid var(--color-focus); outline-offset: 2px; }
  .option input { width: 1.25rem; height: 1.25rem; margin-top: 0.2rem; accent-color: var(--color-intelligent-blue); }
  .option input:focus-visible { outline: none; }
  .option label { font-weight: 600; line-height: 1.45; cursor: pointer; }
  .option label::after { content: ''; position: absolute; inset: 0; }
  .option-hint { grid-column: 2; margin-top: 0.15rem; font-size: 0.9rem; color: var(--color-text-light); }
  .option-unsure { margin-top: 0.5rem; border-style: dashed; }

  .explainer { margin: 0 0 1rem; padding-left: 1rem; border-left: 4px solid var(--color-surface-alt); }
  .explainer summary { padding: 0.6rem 0; font-weight: 600; color: var(--color-intelligent-blue); cursor: pointer; }
  .explainer p { margin: 0.25rem 0 0.75rem; }

  .question-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; margin-top: 1.5rem; }
  .back-link { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; text-decoration: underline; }
  .btn-link {
    min-height: 44px; padding: 0 0.25rem; border: 0; background: none; color: var(--color-link);
    font: inherit; font-weight: 600; text-decoration: underline; cursor: pointer;
  }
  .btn-link:hover { color: var(--color-link-hover); }

  .error-summary { margin-bottom: 1.5rem; padding: 1rem 1.25rem; border: 3px solid #b42318; border-radius: var(--radius); background: #fef3f2; }
  .error-summary:focus { outline: 3px solid var(--color-focus); outline-offset: 2px; }
  .error-summary h2 { font-size: 1.1rem; color: #7a271a; margin-bottom: 0.25rem; }
  .error-summary ul { padding-left: 1.25rem; }
  .error-summary a { color: #7a271a; font-weight: 600; text-decoration: underline; }
  .field-error { margin: 0.25rem 0 0.5rem; color: #b42318; font-weight: 700; }
  .has-error .options { padding-left: 0.875rem; border-left: 4px solid #b42318; }
  .form-group.has-error input { border-color: #b42318; border-width: 2px; }

  .result-position { margin-bottom: 1rem; padding: 1.5rem; border: 2px solid; border-radius: 12px; }
  .tone-in-scope, .tone-action-plan { border-color: var(--color-intelligent-blue); background: #eef5fa; }
  .tone-outside-checked-scope { border-color: var(--color-text-light); background: #f4f5f7; }
  .tone-needs-review { border-color: #8a6100; background: #fff8e1; }
  .position-label { font-size: 0.85rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-midnight-blue); }
  .result-position h1 { margin-top: 0.25rem; }
  .fixture-inline { margin-top: 0.75rem; font-size: 0.9rem; color: #3d2b00; }
  .position-actions { margin-top: 1rem; }

  .result-section { padding: 1.75rem 0; border-top: 1px solid var(--color-surface-alt); }
  .result-section:first-of-type { border-top: 0; }
  .result-section h2 { font-size: 1.35rem; color: var(--color-midnight-blue); margin-bottom: 0.75rem; }
  .result-section h3 { font-size: 1.05rem; margin: 1.25rem 0 0.5rem; color: var(--color-midnight-blue); }
  .reason-list { display: grid; gap: 0.6rem; padding-left: 1.25rem; }
  .ref { display: block; font-size: 0.85rem; color: var(--color-text-light); }
  .obligations { display: grid; gap: 0.75rem; }
  .obligations > div { padding: 0.75rem 1rem; border-radius: var(--radius); background: var(--color-surface); }
  .obligations dt { font-weight: 700; }
  .obligations dd { margin: 0; }

  .steps { display: grid; gap: 1.25rem; list-style: none; counter-reset: step; }
  .steps li { position: relative; padding-left: 2.75rem; counter-increment: step; }
  .steps li::before {
    content: counter(step); position: absolute; left: 0; top: 0; display: grid; place-items: center;
    width: 2rem; height: 2rem; border-radius: 50%; background: var(--color-midnight-blue); color: var(--color-white); font-size: 0.9rem; font-weight: 700;
  }
  .steps h3 { margin: 0 0 0.25rem; font-size: 1.05rem; }
  .owner { display: inline-block; margin-bottom: 0.25rem; padding: 0 0.5rem; border: 1px solid currentColor; border-radius: 999px; font-size: 0.78rem; font-weight: 700; }
  .owner-you { color: var(--color-midnight-blue); }
  .owner-vigilon { color: var(--color-intelligent-blue); }
  .owner-ongoing { color: #5b4b00; }
  .step-deps { font-size: 0.875rem; color: var(--color-text-light); }

  .service-list { display: grid; gap: 0.75rem; list-style: none; }
  .service-list li { display: flex; flex-direction: column; }
  .service-list a { font-weight: 700; }
  .service-list span { color: var(--color-text-light); }

  .answer-row { display: grid; grid-template-columns: minmax(8rem, 14rem) minmax(0, 1fr) auto; gap: 0.25rem 1rem; padding: 0.75rem 0; border-bottom: 1px solid var(--color-surface-alt); }
  .answer-row dt { font-weight: 700; }
  .answer-row dd { margin: 0; }
  .answer-change a { display: inline-flex; min-height: 44px; align-items: center; }

  .source-list { display: grid; gap: 0.5rem; margin: 0.75rem 0; padding-left: 1.25rem; }
  .source-list span { color: var(--color-text-light); font-size: 0.9rem; }
  .scope-note { font-size: 0.925rem; color: var(--color-text-light); }

  .action-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1rem; }
  .save-note, .privacy-note { margin-top: 0.75rem; font-size: 0.9rem; color: var(--color-text-light); }

  .contact-step form { margin-top: 1.5rem; }
  .optional { font-weight: 400; color: var(--color-text-light); }
  .sent-preview { margin: 0.5rem 0 1rem; }
  .sent-preview summary { padding: 0.6rem 0; font-weight: 600; color: var(--color-intelligent-blue); cursor: pointer; }
  .sent-preview pre { max-height: 20rem; overflow: auto; padding: 1rem; border-radius: var(--radius); background: var(--color-surface); white-space: pre-wrap; font-size: 0.8rem; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .confirmation { padding: 1.5rem; border: 2px solid #067647; border-radius: 12px; background: #ecfdf3; }

  .tool-help { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--color-surface-alt); font-size: 0.95rem; color: var(--color-text-light); }
  .tool-help h2 { font-size: 1.05rem; color: var(--color-midnight-blue); margin: 1rem 0 0.25rem; }
  .tool-help h2:first-child { margin-top: 0; }

  @media (max-width: 600px) {
    .answer-row { grid-template-columns: minmax(0, 1fr) auto; }
    .answer-row dt { grid-column: 1 / -1; }
    .question-actions .btn, .action-row .btn { width: 100%; }
  }

  @media print {
    .site-header, .site-footer, .skip-link, .tool-help, .tool-stages, .position-actions, .action-row,
    .answer-change, .tool-notice, .save-note { display: none !important; }
    .guided-tool { padding: 0; min-height: 0; }
    .result-position { border-width: 1px; }
    .steps li, .obligations > div { break-inside: avoid; }
    .source-list a::after { content: ' (' attr(href) ')'; font-size: 0.8rem; }
  }
</style>
