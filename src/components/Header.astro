---
const pathname = Astro.url.pathname;

const solutions = [
  {
    href: '/services/red-cyber-compliance',
    title: 'RED Cybersecurity Testing',
    text: 'Radio Equipment Directive testing against EN 18031',
  },
  {
    href: '/services/cyber-resilience-act',
    title: 'CRA Readiness & Technical Documentation',
    text: 'Cyber Resilience Act gap analysis, evidence and documentation',
  },
  {
    href: '/services#other-assessments',
    title: 'Other Standards & Security Assessments',
    text: 'ETSI EN 303 645, penetration testing, risk assessment, scanning',
  },
];

const resources = [
  { href: '/resources#tools', title: 'Guided compliance checks', text: 'RED and CRA scope, CRA roadmap, reporting readiness' },
  { href: '/blog', title: 'Guides', text: 'Articles on RED, CRA and product security' },
  { href: '/faq', title: 'FAQ', text: 'Answers to common questions' },
];

const inSolutions = pathname.startsWith('/services') || pathname === '/packages';
const inResources = ['/resources', '/blog', '/faq', '/tools'].some((path) => pathname.startsWith(path));
const current = (href: string) => (pathname === href ? 'page' : undefined);
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo">
      <img src="/favicon.svg" alt="" width="28" height="28" />
      Vigilon <span>Cyber</span>
    </a>

    <button class="mobile-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
      <span class="sr-only">Menu</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul class="nav-links">
        <li class="nav-dropdown">
          <button type="button" class:list={['nav-trigger', { active: inSolutions }]} aria-expanded="false" aria-controls="menu-solutions" data-menu-trigger>
            Solutions
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <div class="dropdown-menu" id="menu-solutions" hidden>
            <ul>
              {solutions.map((item) => (
                <li>
                  <a href={item.href} aria-current={current(item.href)}>
                    <strong>{item.title}</strong>
                    <span>{item.text}</span>
                  </a>
                </li>
              ))}
            </ul>
            <a href="/services" class="dropdown-view-all" aria-current={current('/services')}>All services</a>
          </div>
        </li>

        <li><a href="/continuum" class:list={{ active: pathname === '/continuum' }} aria-current={current('/continuum')}>Vigilon Continuum</a></li>

        <li class="nav-dropdown">
          <button type="button" class:list={['nav-trigger', { active: inResources }]} aria-expanded="false" aria-controls="menu-resources" data-menu-trigger>
            Resources
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <div class="dropdown-menu" id="menu-resources" hidden>
            <ul>
              {resources.map((item) => (
                <li>
                  <a href={item.href} aria-current={current(item.href)}>
                    <strong>{item.title}</strong>
                    <span>{item.text}</span>
                  </a>
                </li>
              ))}
            </ul>
            <a href="/resources" class="dropdown-view-all" aria-current={current('/resources')}>All resources</a>
          </div>
        </li>

        <li><a href="/about" class:list={{ active: pathname === '/about' }} aria-current={current('/about')}>About</a></li>
        <li><a href="/request-quote" class="nav-cta">Talk to an expert</a></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = header?.querySelector<HTMLElement>('#site-nav');
  const triggers = Array.from(header?.querySelectorAll<HTMLButtonElement>('[data-menu-trigger]') ?? []);

  const isOpen = (button: HTMLButtonElement) => button.getAttribute('aria-expanded') === 'true';

  const setMenu = (trigger: HTMLButtonElement, open: boolean) => {
    trigger.setAttribute('aria-expanded', String(open));
    const menu = document.getElementById(trigger.getAttribute('aria-controls') ?? '');
    if (menu) menu.hidden = !open;
  };

  const closeMenus = (except?: HTMLButtonElement) => triggers.forEach((trigger) => trigger !== except && setMenu(trigger, false));

  const setNav = (open: boolean) => {
    if (!toggle || !nav) return;
    toggle.setAttribute('aria-expanded', String(open));
    nav.classList.toggle('open', open);
    if (!open) closeMenus();
  };

  if (header) {
    triggers.forEach((trigger) =>
      trigger.addEventListener('click', () => {
        const open = !isOpen(trigger);
        closeMenus(trigger);
        setMenu(trigger, open);
      }),
    );

    toggle?.addEventListener('click', () => setNav(!isOpen(toggle)));

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      const openTrigger = triggers.find(isOpen);
      if (openTrigger) {
        setMenu(openTrigger, false);
        openTrigger.focus();
      } else if (toggle && isOpen(toggle)) {
        setNav(false);
        toggle.focus();
      }
    });

    document.addEventListener('click', (event) => {
      if (!header.contains(event.target as Node)) {
        closeMenus();
        if (toggle && isOpen(toggle)) setNav(false);
      }
    });

    // Close a dropdown when keyboard focus moves out of it.
    header.addEventListener('focusout', (event) => {
      const next = event.relatedTarget as Node | null;
      if (!next) return;
      triggers.forEach((trigger) => {
        const item = trigger.closest('li');
        if (item && !item.contains(next)) setMenu(trigger, false);
      });
    });

    window.matchMedia('(min-width: 961px)').addEventListener('change', (query) => {
      if (query.matches) setNav(false);
    });
  }
</script>
