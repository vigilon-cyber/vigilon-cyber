---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'Request a Quote — Cybersecurity Compliance Testing | Vigilon Cyber';
const description = 'Request a no-obligation quote for EN 18031 compliance testing, Cyber Resilience Act readiness, ETSI IoT security, penetration testing, risk assessments or vulnerability scanning from Vigilon Cyber.';
---

<BaseLayout title={title} description={description}>
  <Header slot="header" />

  <section class="page-header">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Home</a><span>/</span><strong>Request a Quote</strong>
      </div>
      <h1>Request a Quote</h1>
      <p>Tell us about your product and compliance needs. We'll respond with a detailed, no-obligation quote within 24 hours.</p>
      <p class="quote-alt">Not sure what you need yet? <a href="/#guided-starts">Try a guided check</a> — you’ll see a result without sharing contact details.</p>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width:720px;">
      <div class="grid grid-2" style="margin-bottom:3rem;">
        <div>
          <h2 style="font-size:1.35rem;margin-bottom:0.75rem;">What happens next?</h2>
          <ol style="padding-left:1.25rem;color:var(--color-text-light);line-height:2;">
            <li>Submit your details below</li>
            <li>We schedule a free 30-minute consultation</li>
            <li>We assess your requirements and scope</li>
            <li>You receive a detailed quote within 24 hours</li>
          </ol>
        </div>
        <div>
          <h2 style="font-size:1.35rem;margin-bottom:0.75rem;">Contact us directly</h2>
          <p style="color:var(--color-text-light);">
            <strong>Email:</strong> <a href="mailto:info@vigiloncyber.com">info@vigiloncyber.com</a><br/>
            <strong>Phone:</strong> <a href="tel:+18023495325">+1 (802) 349-5325</a><br/>
            <strong>Hours:</strong> Mon – Fri 08:00AM – 08:00PM EST
          </p>
        </div>
      </div>

      <div id="form-success" style="display:none;background:#f0fdf4;border:1px solid #86efac;border-radius:8px;padding:2rem;text-align:center;">
        <p style="font-size:1.25rem;font-weight:600;color:#166534;margin:0 0 0.5rem;">Thank you — we've received your request!</p>
        <p style="color:#15803d;margin:0;">We'll be in touch with a detailed quote within 24 hours.</p>
      </div>

      <div id="form-error" style="display:none;background:#fef2f2;border:1px solid #fca5a5;border-radius:8px;padding:1.25rem;margin-bottom:1.5rem;">
        <p style="color:#991b1b;margin:0;font-weight:600;">Something went wrong — please try again or email us directly at <a href="mailto:info@vigiloncyber.com" style="color:#991b1b;">info@vigiloncyber.com</a>.</p>
      </div>

      <form id="quote-form" name="quote-request" method="POST">
        <div class="grid grid-2">
          <div class="form-group">
            <label for="firstName">First Name *</label>
            <input type="text" id="firstName" name="firstName" required autocomplete="given-name" />
          </div>
          <div class="form-group">
            <label for="lastName">Last Name *</label>
            <input type="text" id="lastName" name="lastName" required autocomplete="family-name" />
          </div>
        </div>

        <div class="grid grid-2">
          <div class="form-group">
            <label for="email">Work Email *</label>
            <input type="email" id="email" name="email" required autocomplete="email" />
          </div>
          <div class="form-group">
            <label for="phone">Phone Number</label>
            <input type="tel" id="phone" name="phone" autocomplete="tel" />
          </div>
        </div>

        <div class="grid grid-2">
          <div class="form-group">
            <label for="company">Company Name *</label>
            <input type="text" id="company" name="company" required autocomplete="organization" />
          </div>
          <div class="form-group">
            <label for="jobTitle">Job Title</label>
            <input type="text" id="jobTitle" name="jobTitle" autocomplete="organization-title" />
          </div>
        </div>

        <div class="form-group">
          <label for="service">Which service(s) are you interested in? *</label>
          <select id="service" name="service" required>
            <option value="">Select a service</option>
            <option value="en-18031">RED Cybersecurity Testing (EN 18031)</option>
            <option value="cra">CRA Readiness &amp; Technical Documentation</option>
            <option value="continuum">Vigilon Continuum</option>
            <option value="etsi">ETSI EN 303 645 IoT Security</option>
            <option value="pentest">Penetration Testing</option>
            <option value="risk">Risk Assessment & Threat Modelling</option>
            <option value="vuln-scan">Vulnerability Scanning</option>
            <option value="multiple">Multiple Services / Bundle</option>
            <option value="not-sure">Not Sure — Need Guidance</option>
          </select>
        </div>

        <div class="form-group">
          <label for="productDescription">Tell us about your product *</label>
          <textarea id="productDescription" name="productDescription" required placeholder="Briefly describe your product, its connectivity (Wi-Fi, Bluetooth, cellular, etc.), target market, and where you are in the development lifecycle."></textarea>
        </div>

        <div class="form-group">
          <label for="compliancePath">Preferred compliance pathway</label>
          <select id="compliancePath" name="compliancePath">
            <option value="">Select if applicable</option>
            <option value="self-declaration">Self-declaration (Module A)</option>
            <option value="notified-body">Notified Body assessment (Module B+C)</option>
            <option value="not-sure">Not sure — need guidance</option>
          </select>
        </div>

        <div class="form-group">
          <label for="timeline">Target timeline</label>
          <select id="timeline" name="timeline">
            <option value="">Select a timeline</option>
            <option value="urgent">Urgent — within 4 weeks</option>
            <option value="standard">Standard — 1–3 months</option>
            <option value="planning">Planning — 3–6 months</option>
            <option value="future">Future — 6+ months</option>
          </select>
        </div>

        <div class="form-group">
          <label for="additionalInfo">Additional information</label>
          <textarea id="additionalInfo" name="additionalInfo" placeholder="Any other details that would help us scope your engagement — e.g., number of products, existing certifications, specific regulatory concerns."></textarea>
        </div>

        <!-- Honeypot fields for bot prevention -->
        <div style="display:none;" aria-hidden="true">
          <label for="website">Website</label>
          <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
        </div>
        <div style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden;" aria-hidden="true">
          <label for="fax">Fax Number</label>
          <input type="text" id="fax" name="fax" tabindex="-1" autocomplete="off" />
        </div>

        <button type="submit" id="submit-btn" class="btn btn-primary btn-lg" style="width:100%;justify-content:center;">
          Submit Quote Request
        </button>

        <p style="text-align:center;margin-top:1rem;font-size:0.875rem;color:var(--color-text-light);">
          By submitting this form, you agree to our privacy policy. We will never share your information with third parties.
        </p>
      </form>

      <script>
        import { reportQuoteConversion } from '../lib/analytics.ts';

        const form = document.getElementById('quote-form') as HTMLFormElement | null;
        const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
        const successEl = document.getElementById('form-success') as HTMLElement | null;
        const errorEl = document.getElementById('form-error') as HTMLElement | null;
        const serviceSelect = document.getElementById('service') as HTMLSelectElement | null;

        // Pre-select a service from links such as /request-quote?service=continuum
        const requestedService = new URLSearchParams(window.location.search).get('service');
        if (requestedService && serviceSelect && Array.from(serviceSelect.options).some((option) => option.value === requestedService)) {
          serviceSelect.value = requestedService;
        }

        form?.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (!form || !submitBtn || !successEl || !errorEl) return;

          errorEl.style.display = 'none';
          submitBtn.disabled = true;
          submitBtn.textContent = 'Sending…';

          const payload = new FormData(form);
          // Honeypot tripped → bot. Server discards it; never fire the Ads conversion.
          const isBot = Boolean(payload.get('website') || payload.get('fax'));

          try {
            const response = await fetch('/api/quote', {
              method: 'POST',
              body: payload,
            });

            if (response.ok) {
              form.style.display = 'none';
              successEl.style.display = 'block';
              successEl.scrollIntoView({ behavior: 'smooth', block: 'center' });

              // Google Ads conversion — fires only on confirmed human submission
              if (!isBot) reportQuoteConversion();
            } else {
              errorEl.style.display = 'block';
              submitBtn.disabled = false;
              submitBtn.textContent = 'Submit Quote Request';
              errorEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
          } catch {
            errorEl.style.display = 'block';
            submitBtn.disabled = false;
            submitBtn.textContent = 'Submit Quote Request';
            errorEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }
        });
      </script>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .quote-alt { margin-top: 0.75rem; font-size: 1rem; }
</style>
