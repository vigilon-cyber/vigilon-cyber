---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroSlideshow from '../components/HeroSlideshow.astro';
import DevNote from '../components/DevNote.astro';
import { resolveToolCards, toolLinkOr } from '../lib/tools/registry.ts';
import type { ToolId } from '../lib/tools/types.ts';

const title = 'Vigilon Cyber | RED Testing, CRA Technical Documentation & Reporting';
const description = 'Vigilon Cyber helps manufacturers meet EU Radio Equipment Directive (RED) and Cyber Resilience Act (CRA) cybersecurity requirements with independent testing, technical documentation and Vigilon Continuum.';

const env = { dev: import.meta.env.DEV, previewFlag: import.meta.env.PUBLIC_GUIDED_TOOLS_PREVIEW };
const toolLink = (id: ToolId, fallback: string) => toolLinkOr(id, fallback, env);
const cards = resolveToolCards(env);

const offers = [
  {
    kind: 'Testing service',
    title: 'RED Cybersecurity Testing',
    description: 'Assess radio products against the RED cybersecurity requirements in Article 3(3)(d), (e) and (f) using the EN 18031 harmonised standards, and build the test evidence your technical documentation needs.',
    primary: { label: 'Scope my RED testing', href: toolLink('red-scope', '/request-quote') },
    more: { label: 'About RED testing', href: '/services/red-cyber-compliance' },
  },
  {
    kind: 'Documentation service',
    title: 'CRA Readiness & Technical Documentation',
    description: 'Identify gaps against the Cyber Resilience Act, plan the work, and assemble the evidence and technical documentation — the technical dossier — the CRA requires.',
    primary: { label: 'Build my CRA roadmap', href: toolLink('cra-roadmap', '/request-quote') },
    more: { label: 'About CRA support', href: '/services/cyber-resilience-act' },
  },
  {
    kind: 'Software',
    title: 'Vigilon Continuum',
    description: 'Vigilon’s reporting platform for ongoing product cybersecurity work. It supports automated report generation via continuous monitoring for notifications required to be submittted to the EU’s official Single Reporting Platform within 24-hours.',
    primary: { label: 'Explore Continuum', href: '/continuum' },
    more: null,
  },
];

const process = [
  {
    title: 'Scope',
    text: 'Confirm which requirements apply to each product, and what your role means.',
    link: { label: 'Check RED or CRA scope', href: '#guided-starts' },
  },
  {
    title: 'Assess',
    text: 'Find the gaps through gap analysis, risk assessment and security testing.',
    link: { label: 'Explore assessments', href: '/services' },
  },
  {
    title: 'Build evidence',
    text: 'Turn test results and design information into technical documentation.',
    link: { label: 'About technical documentation', href: '/services/cyber-resilience-act#technical-documentation' },
  },
  {
    title: 'Support ongoing obligations',
    text: 'Keep vulnerability handling, security updates and reporting running after launch.',
    link: { label: 'Check reporting readiness', href: toolLink('reporting-readiness', '/services/cyber-resilience-act#vulnerability-handling') },
  },
];

const otherAssessments = [
  { title: 'ETSI EN 303 645 IoT security', text: 'Assessment against the European baseline standard for consumer IoT devices.', href: '/services/etsi-iot-security' },
  { title: 'Penetration testing', text: 'Testing of devices, web applications, APIs, mobile apps and cloud infrastructure.', href: '/services/penetration-testing' },
  { title: 'Risk assessment & threat modelling', text: 'Structured, documented risk assessments for connected products.', href: '/services/risk-assessment' },
  { title: 'Vulnerability scanning', text: 'Scheduled scanning of your external attack surface, networks and cloud environments.', href: '/services/vulnerability-scanning' },
];

const guides = [
  {
    title: 'Radio Equipment Directive: Cybersecurity Requirements Explained',
    href: '/blog/red-compliance-2026',
    published: 'March 2026',
    related: { label: 'RED scope check', href: toolLink('red-scope', '/services/red-cyber-compliance') },
  },
  {
    title: 'Cyber Resilience Act: What Manufacturers Need to Know',
    href: '/blog/cyber-resilience-act-overview',
    published: 'February 2026',
    related: { label: 'CRA scope check', href: toolLink('cra-scope', '/services/cyber-resilience-act') },
  },
  {
    title: 'The Complete Guide to EN 18031-1 Compliance',
    href: '/blog/en-18031-complete-guide',
    published: 'April 2026',
    related: { label: 'RED cybersecurity testing', href: '/services/red-cyber-compliance' },
  },
];

const credibility = [
  { title: 'Product compliance specialists', text: 'We focus on cybersecurity compliance for connected products entering the EU market.' },
  { title: 'Both assessment routes', text: 'Support for self-declaration and for preparing a Notified Body assessment.' },
  { title: 'Standards-based work', text: 'Assessments against EN 18031, ETSI EN 303 645 and established security testing methods.' },
  { title: 'Actionable reporting', text: 'Findings come with remediation guidance prioritised by risk.' },
];
---

<BaseLayout title={title} description={description}>
  <Header slot="header" />

  <HeroSlideshow
    video="/images/vigilon-hero-loop.mp4"
    headline="Product cybersecurity compliance, from testing to ongoing reporting."
    description="Vigilon helps manufacturers navigate the EU Radio Equipment Directive (RED) and Cyber Resilience Act (CRA) with independent testing, technical documentation and Vigilon Continuum."
  >
    <Fragment slot="actions">
      <a href="#guided-starts" class="btn btn-primary btn-lg">Find my compliance path</a>
      <a href="/services" class="btn btn-ghost btn-lg">Explore our solutions</a>
    </Fragment>
  </HeroSlideshow>

  <section id="guided-starts" class="section guided-starts" aria-labelledby="guided-starts-title">
    <div class="container">
      <div class="guided-intro">
        <h2 id="guided-starts-title">Find your next compliance step</h2>
        <p>Answer a few questions about one product. You’ll see your result straight away — no contact details needed.</p>
      </div>

      <p class="reporting-callout">
        <span class="callout-date">Since 11 September 2026</span>
        CRA reporting obligations apply to manufacturers of products in scope.
        <a href={toolLink('reporting-readiness', '/services/cyber-resilience-act#vulnerability-handling')}>Check your reporting readiness</a>
      </p>

      <ul class="task-grid">
        {cards.map((card) => (
          <li class="task-card" data-task-card={card.toolId}>
            <h3>{card.title}</h3>
            <p>{card.description}</p>
            <a href={card.href} class="task-card-link">
              {card.label}
              <span aria-hidden="true">→</span>
            </a>
            {card.preview && <span class="preview-tag">Preview · rules not yet reviewed</span>}
          </li>
        ))}
      </ul>

      <p class="bypass">
        Already know what you need? <a href="/services">Explore services</a> or <a href="/request-quote">request a quote</a>.
      </p>
    </div>
  </section>

  <section class="credibility" aria-labelledby="credibility-title">
    <div class="container">
      <h2 id="credibility-title" class="credibility-title">Why manufacturers work with Vigilon</h2>
      <ul class="credibility-list">
        {credibility.map((item) => (
          <li>
            <strong>{item.title}</strong>
            <span>{item.text}</span>
          </li>
        ))}
      </ul>
      <DevNote inputs={['INPUT-04']}>
        <p>These points reuse claims already on the live site. Add verified evidence — named experts, distinguished personal and company credentials, an approved redacted report, or an attributed case study — before expanding this section.</p>
      </DevNote>
    </div>
  </section>

  <section id="offers" class="section" aria-labelledby="offers-title">
    <div class="container">
      <div class="section-header">
        <h2 id="offers-title">Testing, documentation and ongoing reporting</h2>
        <p>Each offer stands on its own, and they work together: test evidence feeds your technical documentation, and your processes continue after launch.</p>
      </div>
      <div class="offer-list">
        {offers.map((offer) => (
          <article class="offer">
            <p class="offer-kind">{offer.kind}</p>
            <div class="offer-body">
              <h3>{offer.title}</h3>
              <p>{offer.description}</p>
            </div>
            <div class="offer-actions">
              <a href={offer.primary.href} class="btn btn-secondary">{offer.primary.label}</a>
              {offer.more && <a href={offer.more.href} class="offer-more">{offer.more.label}</a>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="process" class="section section-alt" aria-labelledby="process-title">
    <div class="container">
      <div class="section-header">
        <h2 id="process-title">Start where you are</h2>
        <p>Most projects move through four stages. You can bring us in at any of them.</p>
      </div>
      <ol class="process-list">
        {process.map((step, index) => (
          <li>
            <span class="process-number" aria-hidden="true">{index + 1}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
            <a href={step.link.href}>{step.link.label}</a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <div class="container">
    <DevNote inputs={['INPUT-03', 'INPUT-04']}>
      <p>Brief sections 6 (Continuum preview) and 7 (proof) are omitted until an approved product screenshot or demo, verified capabilities, and an approved sample deliverable or case study exist. Continuum remains discoverable through the navigation, the offers above and /continuum.</p>
    </DevNote>
  </div>

  <section id="other-assessments" class="section" aria-labelledby="other-title">
    <div class="container">
      <div class="split-header">
        <div>
          <h2 id="other-title">Other standards and security assessments</h2>
          <p>Broader product security work, on its own or alongside RED and CRA projects.</p>
        </div>
        <a href="/services#other-assessments" class="btn btn-outline">Find an assessment</a>
      </div>
      <ul class="assessment-list">
        {otherAssessments.map((item) => (
          <li>
            <a href={item.href}>{item.title}</a>
            <span>{item.text}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="resources" class="section section-alt" aria-labelledby="resources-title">
    <div class="container">
      <div class="split-header">
        <div>
          <h2 id="resources-title">Guides</h2>
          <p>Background reading on the requirements behind the checks.</p>
        </div>
        <a href="/resources" class="btn btn-outline">All resources</a>
      </div>
      <ul class="guide-list">
        {guides.map((guide) => (
          <li class="guide">
            <p class="guide-meta">Published {guide.published}</p>
            <h3><a href={guide.href}>{guide.title}</a></h3>
            <p class="guide-related">Related: <a href={guide.related.href}>{guide.related.label}</a></p>
          </li>
        ))}
      </ul>
      <DevNote inputs={['Guide review']}>
        <p>The brief asks for author and substantive review dates. The existing posts have neither, and some statements predate current sources (for example, the RED delegated regulation’s repeal from 11 December 2027 and the CRA notification route). Review them before relying on this section.</p>
      </DevNote>
    </div>
  </section>

  <section class="section section-dark final-contact" aria-labelledby="contact-title">
    <div class="container text-center">
      <h2 id="contact-title">Ready to scope a project?</h2>
      <p>Tell us about your product and what you need, and we’ll outline the work involved.</p>
      <div class="final-actions">
        <a href="/request-quote" class="btn btn-primary btn-lg">Talk to an expert</a>
        <a href="mailto:info@vigiloncyber.com" class="btn btn-outline btn-lg">Email info@vigiloncyber.com</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<script>
  import { trackGuided } from '../lib/analytics.ts';

  const cards = document.querySelectorAll<HTMLElement>('[data-task-card]');
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const card = entry.target as HTMLElement;
          observer.unobserve(card);
          trackGuided('task_card_viewed', { tool_id: card.dataset.taskCard ?? 'unknown' });
        }
      },
      { threshold: 0.5 },
    );
    cards.forEach((card) => observer.observe(card));
  }
</script>

<style>
  .guided-starts { padding-top: 4rem; }
  .guided-intro { max-width: 640px; margin-bottom: 1.5rem; }
  .guided-intro h2 { font-size: 2.25rem; font-weight: 800; margin-bottom: 0.5rem; }
  .guided-intro p { font-size: 1.125rem; color: var(--color-text-light); }

  .reporting-callout {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.35rem 0.75rem;
    margin-bottom: 2rem; padding: 0.875rem 1.125rem;
    border-left: 4px solid var(--color-intelligent-blue); border-radius: 0 var(--radius) var(--radius) 0;
    background: var(--color-surface);
  }
  .callout-date { font-weight: 700; color: var(--color-midnight-blue); }

  .task-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; list-style: none; }
  .task-card {
    position: relative; display: flex; flex-direction: column; gap: 0.5rem;
    padding: 1.5rem 1.5rem 1.25rem; border: 1px solid #C9D2DC; border-radius: var(--radius);
    background: var(--color-white); transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
  }
  .task-card:hover, .task-card:focus-within {
    transform: translateY(-3px); border-color: var(--color-intelligent-blue); box-shadow: var(--shadow-lg);
  }
  .task-card h3 { font-size: 1.25rem; color: var(--color-midnight-blue); }
  .task-card p { color: var(--color-text-light); flex: 1; }
  .task-card-link {
    display: inline-flex; align-items: center; gap: 0.4rem; min-height: 44px; align-self: flex-start;
    font-weight: 700; color: var(--color-intelligent-blue); text-decoration: none;
  }
  /* Whole card is clickable; the link keeps its own accessible name. */
  .task-card-link::after { content: ''; position: absolute; inset: 0; border-radius: var(--radius); }
  .task-card-link:focus-visible { outline: none; }
  .task-card-link:focus-visible::after { outline: 3px solid var(--color-focus); outline-offset: 2px; }
  .preview-tag {
    align-self: flex-start; padding: 0.15rem 0.5rem; border: 1px dashed #8A6100; border-radius: 4px;
    background: #FFF8E1; color: #3D2B00; font-size: 0.75rem; font-weight: 600;
  }
  .bypass { margin-top: 1.5rem; color: var(--color-text-light); }

  .credibility { padding: 2.5rem 0; background: var(--color-surface); border-block: 1px solid var(--color-surface-alt); }
  .credibility-title { font-size: 1rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-text-light); margin-bottom: 1.25rem; }
  .credibility-list { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.5rem; list-style: none; }
  .credibility-list strong { display: block; color: var(--color-midnight-blue); margin-bottom: 0.25rem; }
  .credibility-list span { display: block; font-size: 0.925rem; color: var(--color-text-light); line-height: 1.55; }

  .offer-list { display: grid; gap: 1rem; }
  .offer {
    display: grid; grid-template-columns: 11rem minmax(0, 1fr) auto; align-items: center; gap: 1rem 2rem;
    padding: 1.75rem 0; border-top: 1px solid var(--color-surface-alt);
  }
  .offer:last-child { border-bottom: 1px solid var(--color-surface-alt); }
  .offer-kind { font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-intelligent-blue); }
  .offer-body h3 { font-size: 1.5rem; color: var(--color-midnight-blue); margin-bottom: 0.35rem; }
  .offer-body p { color: var(--color-text-light); max-width: 62ch; }
  .offer-actions { display: flex; flex-direction: column; align-items: flex-start; gap: 0.5rem; }
  .offer-more { min-height: 44px; display: inline-flex; align-items: center; font-weight: 600; }

  .process-list { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.5rem; list-style: none; counter-reset: none; }
  .process-list li { display: flex; flex-direction: column; gap: 0.5rem; padding-top: 1rem; border-top: 3px solid var(--color-intelligent-blue); }
  .process-number { font-size: 0.85rem; font-weight: 700; color: var(--color-intelligent-blue); }
  .process-list h3 { font-size: 1.2rem; color: var(--color-midnight-blue); }
  .process-list p { color: var(--color-text-light); flex: 1; }
  .process-list a { font-weight: 600; min-height: 44px; display: inline-flex; align-items: center; }

  .split-header { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1rem 2rem; margin-bottom: 2rem; }
  .split-header h2 { font-size: 2rem; font-weight: 800; margin-bottom: 0.35rem; }
  .split-header p { color: var(--color-text-light); }

  .assessment-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 2.5rem; list-style: none; }
  .assessment-list li { display: flex; flex-direction: column; padding: 1rem 0; border-top: 1px solid var(--color-surface-alt); }
  .assessment-list a { font-weight: 700; font-size: 1.1rem; }
  .assessment-list span { color: var(--color-text-light); }

  .guide-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; list-style: none; }
  .guide { padding: 1.5rem; background: var(--color-white); border-radius: var(--radius); box-shadow: var(--shadow-sm); border: 1px solid var(--color-surface-alt); }
  .guide h3 { font-size: 1.15rem; margin: 0.25rem 0 0.75rem; }
  .guide h3 a { color: var(--color-midnight-blue); text-decoration: none; }
  .guide h3 a:hover { color: var(--color-intelligent-blue); text-decoration: underline; }
  .guide-meta { font-size: 0.85rem; color: var(--color-text-light); }
  .guide-related { font-size: 0.925rem; color: var(--color-text-light); }

  .final-contact p { color: var(--color-text-on-dark); max-width: 560px; margin: 1rem auto 2rem; }
  .final-actions { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center; }
  .final-actions .btn { overflow-wrap: anywhere; }

  @media (max-width: 1024px) {
    .credibility-list, .process-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .offer { grid-template-columns: minmax(0, 1fr); gap: 0.5rem; }
    .offer-actions { flex-direction: row; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.25rem; margin-top: 0.5rem; }
    .guide-list { grid-template-columns: minmax(0, 1fr); }
  }

  @media (max-width: 760px) {
    .guided-starts { padding-top: 2.5rem; }
    .guided-intro h2 { font-size: 1.75rem; }
    .task-grid, .assessment-list, .credibility-list, .process-list { grid-template-columns: minmax(0, 1fr); }
    .split-header h2 { font-size: 1.6rem; }
    .btn-lg { padding: 0.875rem 1.25rem; font-size: 1rem; }
  }
</style>
